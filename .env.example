# Mela.io Environment Configuration
# Copy to .env for local overrides. Never commit .env or real secrets.

NODE_ENV=development
PORT=3000
# Host server binding. The Docker image binds to 0.0.0.0 internally.
MELA_HOST=127.0.0.1
# Disconnected session reservation and empty invite lifetime (milliseconds).
MELA_RECONNECT_GRACE_MS=30000
MELA_EMPTY_ROOM_TTL_MS=60000

# Sponsor integrations (default to mock mode for local development)
SPONSOR_MODE=mock
SARVAM_API_KEY=
FLAGSMITH_ENVIRONMENT_KEY=
NUDGEBEE_API_KEY=
